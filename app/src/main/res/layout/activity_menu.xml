<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/saborapp_crema">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/tvBienvenida"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="@string/bienvenido_saborapp"
            android:textColor="@color/saborapp_rojo"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp"
            android:text="@string/selecciona_opcion"
            android:textColor="@color/saborapp_negro"
            android:textSize="17sp" />

        <Button
            android:id="@+id/btnPlatos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:backgroundTint="@color/saborapp_naranja"
            android:text="@string/platos"
            android:textColor="@color/saborapp_blanco"
            android:textSize="16sp"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/btnMesas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:backgroundTint="@color/saborapp_naranja"
            android:text="@string/mesas"
            android:textColor="@color/saborapp_blanco"
            android:textSize="16sp"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/btnPedidos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:backgroundTint="@color/saborapp_naranja"
            android:text="@string/pedidos"
            android:textColor="@color/saborapp_blanco"
            android:textSize="16sp"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/btnReportes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:backgroundTint="@color/saborapp_naranja"
            android:text="@string/reportes"
            android:textColor="@color/saborapp_blanco"
            android:textSize="16sp"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/btnSalir"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/saborapp_rojo"
            android:text="@string/salir"
            android:textColor="@color/saborapp_blanco"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textAllCaps="false" />

    </LinearLayout>

</ScrollView>